# =============================================================================
# Remote Dev Server Configuration
# Copy to .env and fill in your values: cp .env.example .env
# =============================================================================

# Server IP (from Hetzner Robot panel after provisioning)
SERVER_IP=

# Tailscale auth key (https://login.tailscale.com/admin/settings/keys)
# Create: one-off, persistent, pre-authorized, 30-day expiry
TAILSCALE_AUTHKEY=

# Tailscale hostname (used for MagicDNS: devbox.your-tailnet.ts.net)
TAILSCALE_HOSTNAME=devbox

# Your repo (SSH URL)
REPO_URL=git@github.com:your-org/your-repo.git

# Anthropic API key (for Claude Code headless auth — no browser needed)
ANTHROPIC_API_KEY=

# Ollama models to pre-pull (space-separated)
OLLAMA_MODELS="snowflake-arctic-embed2 qwen3.5:9b nomic-embed-text"

# Dev user on the server (created by bootstrap)
DEV_USER=dev

# Server hostname (also used for Tailscale if TAILSCALE_HOSTNAME not set separately)
SERVER_HOSTNAME=devbox

# Git identity for the PRIMARY 'dev' user only. Set once during bootstrap Phase 6.
# Additional users created via scripts/add-dev-user.sh get their own name/email
# from the script's command-line arguments — these env vars never apply to them.
# Each user's identity lives independently in /home/<user>/.gitconfig.
GIT_NAME=
GIT_EMAIL=

# Node.js major version to install on host (for devcontainer CLI)
NODE_MAJOR=22

# Timezone (default: UTC)
TIMEZONE=UTC

# Second NVMe disk device (leave empty for single-disk servers to avoid accidental formatting)
# Example: DATA_DISK=/dev/nvme1n1
DATA_DISK=
DATA_MOUNT=/data

# LVM logical volume sizes used by scripts/install-os.sh.
# /data takes whatever is left on the VG after these two are allocated.
# Root holds OS + dotfiles only; workspace and Docker live on /data,
# so 150G root is comfortable even with plenty of installed packages.
# Root + data are xfs (fast, but cannot shrink — only grow).
ROOT_LV_SIZE=150G
SWAP_LV_SIZE=8G

# Software RAID level across the two NVMe drives.
#   1 = mirror: survives a single disk failure, 1× capacity (default)
#   0 = stripe: 2× perf + 2× capacity, NO redundancy (any disk dies = total loss)
# Default 1 — dev state (Ollama models, Docker volumes, WIP workspace) is worth protecting.
RAID_LEVEL=1

# Optional: Stripe secret key (for webhook forwarding)
STRIPE_SECRET_KEY=
