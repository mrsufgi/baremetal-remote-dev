# =============================================================================
# .zshrc — Remote Dev Server (Berries EMR)
# =============================================================================
# Installed to ~/.zshrc on the dev server.
# Designed for SSH sessions: no font dependencies, works in any terminal.
# =============================================================================

# --- Locale ---
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
export LANGUAGE="en_US.UTF-8"

# --- GPG ---
export GPG_TTY="$(tty)"

# --- Oh My Zsh ---
export ZSH="$HOME/.oh-my-zsh"

# Use a simple built-in theme as base (overridden by custom prompt below)
ZSH_THEME=""

plugins=(
  git
  docker
  docker-compose
  fzf
  z
  colored-man-pages
  command-not-found
  extract
  sudo          # press ESC twice to prefix last command with sudo
)

# Disable auto-update prompts (update manually)
zstyle ':omz:update' mode disabled

source "$ZSH/oh-my-zsh.sh" 2>/dev/null || true

# =============================================================================
# Custom Prompt (no Powerline fonts needed)
# =============================================================================
# Format: [hostname] ~/path (git-branch *) $
#   - hostname in blue (you're remote, this matters)
#   - path in green
#   - git branch in yellow, with dirty indicator
#   - red prompt on error
# =============================================================================
_git_prompt_info() {
  local branch
  branch="$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)"
  [[ -z "$branch" ]] && return

  local dirty=""
  if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
    dirty=" *"
  fi

  local untracked=""
  if [[ -n "$(git ls-files --others --exclude-standard 2>/dev/null | head -1)" ]]; then
    untracked=" +"
  fi

  echo " %F{yellow}(${branch}${dirty}${untracked})%f"
}

setopt PROMPT_SUBST
PROMPT='%F{blue}[%m]%f %F{green}%~%f$(_git_prompt_info) %(?.%F{white}.%F{red})$%f '
RPROMPT=''

# =============================================================================
# PATH
# =============================================================================
# Proto (toolchain manager)
export PROTO_HOME="$HOME/.proto"
[[ -d "$PROTO_HOME/shims" ]] && export PATH="$PROTO_HOME/shims:$PROTO_HOME/bin:$PATH"

# Go
export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:/usr/local/go/bin:$PATH"

# Node / Yarn
export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"

# Rust / Cargo
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# Claude CLI
export PATH="$HOME/.claude/bin:$PATH"

# Local bin (user scripts)
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# =============================================================================
# Environment
# =============================================================================
export EDITOR="vim"
export VISUAL="vim"
export PAGER="less -R"

# Ollama
export OLLAMA_HOST="http://localhost:11434"

# Anthropic — set by sync-dotfiles.sh, never hardcoded
# export ANTHROPIC_API_KEY is expected to be in the environment already

# =============================================================================
# History
# =============================================================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt HIST_IGNORE_ALL_DUPS   # remove older duplicates
setopt HIST_FIND_NO_DUPS      # don't show dupes in search
setopt HIST_REDUCE_BLANKS     # trim whitespace
setopt HIST_IGNORE_SPACE      # lines starting with space are private
setopt SHARE_HISTORY          # share across sessions
setopt APPEND_HISTORY         # don't overwrite
setopt INC_APPEND_HISTORY     # write immediately, not on exit
setopt EXTENDED_HISTORY        # save timestamps

# =============================================================================
# fzf
# =============================================================================
# Ctrl+R = fuzzy history search, Ctrl+T = fuzzy file finder
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --color=16"

# Use fd if available (respects .gitignore)
if command -v fdfind &>/dev/null; then
  export FZF_DEFAULT_COMMAND="fdfind --type f --hidden --follow --exclude .git"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND="fdfind --type d --hidden --follow --exclude .git"
elif command -v fd &>/dev/null; then
  export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git"
fi

# Source fzf keybindings and completion
[[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[[ -f /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
# Alternative locations (varies by distro)
[[ -f /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
[[ -f /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh

# =============================================================================
# Aliases — Git
# =============================================================================
alias gs="git status"
alias gd="git diff"
alias gds="git diff --staged"
alias ga="git add"
alias gc="git commit"
alias gca="git commit --amend"
alias gco="git checkout"
alias gb="git branch"
alias gl="git log --oneline --graph --decorate -20"
alias gla="git log --oneline --graph --decorate --all -30"
alias gp="git push"
alias gpl="git pull --rebase"
alias gf="git fetch --all --prune"
alias grb="git rebase"
alias gst="git stash"
alias gstp="git stash pop"

# =============================================================================
# Aliases — Docker
# =============================================================================
alias d="docker"
alias dc="docker compose"
alias dcu="docker compose up -d"
alias dcd="docker compose down"
alias dcl="docker compose logs -f"
alias dcr="docker compose restart"
alias dps="docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'"
alias dpsa="docker ps -a --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'"
alias dimg="docker images --format 'table {{.Repository}}\t{{.Tag}}\t{{.Size}}'"
alias dprune="docker system prune -af --volumes"
alias dlog="docker logs -f"
alias dexec="docker exec -it"
alias dstop="docker stop \$(docker ps -q) 2>/dev/null; echo 'All containers stopped'"

# =============================================================================
# Aliases — Devcontainer
# =============================================================================
alias dcattach="docker exec -it berries-devcontainer-1 zsh 2>/dev/null || docker exec -it berries-devcontainer zsh"

# =============================================================================
# Aliases — Ollama
# =============================================================================
alias oll="ollama"
alias ollrun="ollama run"
alias ollls="ollama list"
alias ollps="ollama ps"
alias ollpull="ollama pull"

# =============================================================================
# Aliases — General
# =============================================================================
alias ll="ls -lah --color=auto"
alias la="ls -A --color=auto"
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias cls="clear"
alias ports="ss -tlnp"
alias myip="curl -s ifconfig.me && echo"
alias diskuse="df -h / /data 2>/dev/null | grep -v tmpfs"
alias memuse="free -h"
alias reload="source ~/.zshrc && echo 'Reloaded'"

# =============================================================================
# tmux auto-attach
# =============================================================================
# If connected via SSH and not already in tmux, offer to attach or create
if [[ -n "$SSH_CONNECTION" ]] && [[ -z "$TMUX" ]] && command -v tmux &>/dev/null; then
  # Check for existing detached sessions
  if tmux has-session 2>/dev/null; then
    echo "\033[0;36m[tmux]\033[0m Existing session found. Attach with: tmux attach"
  else
    echo "\033[0;36m[tmux]\033[0m No session found. Start one with: tmux new -s dev"
  fi
fi

# =============================================================================
# Local overrides (not tracked in git)
# =============================================================================
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
